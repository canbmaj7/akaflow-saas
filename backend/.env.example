# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# API
API_V1_PREFIX=/api/v1

# Faz 3 — Ödeme hatırlatma (Gmail: smtp.gmail.com / Brevo: smtp-relay.brevo.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_DAYS_BEFORE=3
REMINDER_CRON_HOUR=8
ENABLE_SCHEDULER=true

# Faz 4 — AI Asistan
# Google AI Studio → https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Supabase → Project Settings → Database → Connection string (URI, pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Test (opsiyonel — pytest)
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
