# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# API
API_V1_PREFIX=/api/v1

# Faz 4 — AI Agent
# GOOGLE_API_KEY=
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

